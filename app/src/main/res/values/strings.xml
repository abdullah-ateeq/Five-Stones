    <string name="diagram_vertical_desc">Diagram: five Player 2 stones in a vertical column, a winning line.</string>
    <string name="diagram_diagonal_desc">Diagram: five Player 1 stones on a diagonal, a winning line.</string>
    <string name="diagram_broken_desc">Diagram: four Player 1 stones on a diagonal interrupted by a Player 2 stone, not a win.</string>

