    <!-- How to play -->
    <string name="section_rules">The Rules</string>
    <string name="section_examples">Examples</string>
    <string name="rule_turns_title">Take turns</string>
    <string name="rule_turns_body">Player 1 (Obsidian) moves first, then Player 2 (Pearl). Each turn places one stone.</string>
    <string name="rule_intersections_title">Play on intersections</string>
    <string name="rule_intersections_body">Stones sit where the lines cross — never inside the squares.</string>
    <string name="rule_no_moving_title">Stones never move</string>
    <string name="rule_no_moving_body">There are no captures. Once placed, a stone stays for the whole match.</string>
    <string name="rule_line_title">Build a line of five</string>
    <string name="rule_line_body">Connect five stones in a row — horizontally, vertically, or diagonally. Longer lines count too.</string>
    <string name="rule_first_title">First line wins</string>
    <string name="rule_first_body">The first unbroken line of five wins at once. If the board fills with no line, the match is a draw.</string>
